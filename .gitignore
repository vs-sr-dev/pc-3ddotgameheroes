# --- BYOA policy: no proprietary asset in this repository ---
# See docs/RECON.md. Code, tools and format documentation only.

*.iso
extract/
tools/iso_index.tsv

# Disc files and what comes out of them
*.lua.eu
*.tpk
*.dsb
*.dpk
*.edt
*.sav
*.bik
*.wav
*.dds
*.pac
*_PAC.GZ
*.DAT
EBOOT.BIN
*.self
*.elf

# Generated reports that EMBED game content and so cannot be published:
# lua_signatures.* carries literal dialogue samples, lua_tables.* the full
# values of the UI and item tables. Both regenerate in seconds from the tools
# and your own disc.
docs/lua_signatures.*
docs/lua_tables.*

# Third-party material kept locally as an external oracle: a GameFAQs guide,
# used since session 8 to validate readings of enemies and gimmicks. It is
# neither ours nor the disc's, so it is not published.
docs/walkthrough/

# Publishable: RECON.md, STRATEGY.md and generated/*.h hold only method names,
# signatures and constant names -- API surface, not content.
#
# Renders ARE content: a composed screen carries the disc's textures and a map
# frame its geometry. They stay local.
generated/**/*.png
generated/*.png

# Build: the recompiler's C++ is the game's code translated, and the decrypted
# ELF is the game's executable. Neither is ever committed.
build/
out/
__pycache__/
*.pyc

# Key material for the SELF decryption: not game content, but not ours to
# redistribute and not derivable from the disc. tools/self.py takes a path.
keys/
*.keys

# Local: editor settings and the session brief
.claude/
PROMPT.md
